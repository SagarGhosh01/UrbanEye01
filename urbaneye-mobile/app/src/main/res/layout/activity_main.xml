<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- 1. Real Continuous Rear Camera Feed -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:scaleType="fillCenter" />

    <!-- 2. Real-Time Detection Bounding Box Overlay -->
    <com.urbaneye.mobile.ui.OverlayView
        android:id="@+id/overlayView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 3. Top Operator HUD Bar (Mounted Bus Dashboard) -->
    <LinearLayout
        android:id="@+id/topHudBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#CC07162C"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Line 1: Agency Brand & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="URBANEYE"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="#33F59E0B"
                android:paddingStart="6dp"
                android:paddingTop="2dp"
                android:paddingEnd="6dp"
                android:paddingBottom="2dp"
                android:text="BUS SENSOR"
                android:textColor="@color/gov_amber"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvBusLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#3310B981"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="PAIRING REQUIRED"
                android:textColor="@color/gov_emerald"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 2: Telemetry & Edge FPS Metrics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGpsStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS: 19.0760, 72.8777 (28 km/h)"
                android:textColor="#CBD5E1"
                android:textSize="11sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvFps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI: 8.0 FPS"
                android:textColor="@color/gov_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTripEvents"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Trip Events: 0"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Line 3: Live Detection Status -->
        <TextView
            android:id="@+id/tvDetectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="🟢 AI Scanning road surface..."
            android:textColor="#64748B"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 4. PIN Pairing Overlay Screen (Shown when unpaired) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/pairingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F007162C"
        android:clickable="true"
        android:focusable="true"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPairingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:text="URBANEYE MOBILE"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPairingSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Public Bus Road Intelligence Sensor Platform\nMinistry of Road Transport &amp; Highways"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvPairingTitle" />

        <androidx.cardview.widget.CardView
            android:id="@+id/cardPin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardBackgroundColor="#134074"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvPairingSubtitle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="28dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DEVICE PAIRING PIN"
                    android:textColor="@color/gov_amber"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Prominent 6-Digit PIN Display -->
                <TextView
                    android:id="@+id/tvPinCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.2"
                    android:text="------"
                    android:textColor="@color/white"
                    android:textSize="44sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Enter this 6-digit PIN on the UrbanEye Command Web Portal under 'Pair a new bus' to bind to your district."
                    android:textColor="#E2E8F0"
                    android:textSize="12sp" />

                <ProgressBar
                    android:id="@+id/pbPairing"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginTop="16dp"
                    android:indeterminateTint="@color/gov_amber" />

                <TextView
                    android:id="@+id/tvPairingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Awaiting District Head confirmation..."
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardPin">

            <Button
                android:id="@+id/btnRefreshPin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="#1E293B"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Request PIN"
                android:textColor="@color/white"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnServerConfig"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#0F2847"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="Server IP"
                android:textColor="@color/gov_amber"
                android:textSize="11.5sp" />

            <Button
                android:id="@+id/btnDismissPairing"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#10B981"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:text="View Camera"
                android:textColor="@color/white"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServerUrlDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Backend: http://172.21.0.178:5000/"
            android:textColor="#64748B"
            android:textSize="10sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnRefreshPin" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Floating Quick Action Buttons on Camera View -->
    <LinearLayout
        android:id="@+id/cameraActionRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/detectionBanner"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnShowPinOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#CC07162C"
            android:text="Show PIN"
            android:textColor="@color/gov_amber"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btnTriggerTestDefect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#CCDC2626"
            android:text="⚡ Test Pothole"
            android:textColor="@color/white"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Live Detection Alert Banner (bottom of screen) -->
    <LinearLayout
        android:id="@+id/detectionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F0F97316"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:id="@+id/tvDetectionBannerType"
            android:text="🚧 POTHOLE DETECTED"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetectionBannerSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ø 45 cm"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp" />

        <TextView
            android:id="@+id/tvDetectionBannerCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fix: ₹1,850"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
