datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model State {
  id        String     @id @default(cuid())
  code      String     @unique // e.g., MH, KA, DL
  name      String
  centerLat Float
  centerLon Float
  districts District[]
  users     User[]
  createdAt DateTime   @default(now())
}

model District {
  id        String             @id @default(cuid())
  code      String             @unique // e.g. MUMBAI_SUBURBAN, PUNE
  name      String
  stateId   String
  state     State              @relation(fields: [stateId], references: [id], onDelete: Cascade)
  centerLat Float
  centerLon Float
  minLat    Float?
  maxLat    Float?
  minLon    Float?
  maxLon    Float?
  users     User[]
  sessions  BusDeviceSession[]
  events    RoadEvent[]
  createdAt DateTime           @default(now())
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String
  role         String      // NATIONAL_ADMIN | STATE_ADMIN | DISTRICT_HEAD
  stateId      String?
  state        State?      @relation(fields: [stateId], references: [id])
  districtId   String?
  district     District?   @relation(fields: [districtId], references: [id])
  reviews      RoadEvent[] @relation("UserReviewedEvents")
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model BusDeviceSession {
  id            String      @id @default(uuid())
  pin           String      // 6-digit numeric PIN
  status        String      @default("PENDING") // PENDING | PAIRED | EXPIRED
  busLabel      String?     // e.g. MH-01-CV-9821
  routeTag      String?     // e.g. Route 335E
  districtId    String?
  district      District?   @relation(fields: [districtId], references: [id])
  events        RoadEvent[]
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
  pairedAt      DateTime?
  lastHeartbeat DateTime    @default(now())

  @@index([pin, status])
}

model RoadEvent {
  id               String            @id @default(uuid())
  deviceSessionId  String
  session          BusDeviceSession  @relation(fields: [deviceSessionId], references: [id], onDelete: Cascade)
  busLabel         String
  districtId       String
  district         District          @relation(fields: [districtId], references: [id], onDelete: Cascade)
  type             String            // POTHOLE | ROAD_CRACK | SURFACE_DAMAGE | WATERLOGGING | VEHICLE_FLOW
  confidence       Float
  latitude         Float
  longitude        Float
  heading          Float?
  speed            Float?
  imageSnippet        String?           // base64 encoded compact JPEG cropped from edge camera
  estimatedDiameterCm Float?            // Estimated defect/cavity diameter in cm
  estimatedRepairCost Float?            // Estimated PWD/NHAI repair cost in INR
  status              String            @default("NEW") // NEW | REVIEWED | ASSIGNED_FOR_REPAIR | RESOLVED
  reviewedByUserId    String?
  reviewedByUser      User?             @relation("UserReviewedEvents", fields: [reviewedByUserId], references: [id])
  reviewNotes         String?
  timestamp           DateTime          @default(now())
  createdAt           DateTime          @default(now())

  @@index([districtId, status])
  @@index([timestamp])
  @@index([type])
}

model Incident {
  id              String   @id @default(uuid())
  category        String   // ACCIDENT | HIT_AND_RUN | RASH_DRIVING | DANGEROUS_DRIVING | VEHICLE_ANOMALY
  confidence      Float
  latitude        Float
  longitude       Float
  plateText       String?  // Nullable; null outputs "Plate Not Detected"
  vehicleType     String   // CAR | TRUCK | BUS | TWO_WHEELER | AUTO
  speedKmh        Float
  frameTrajectory String   // JSON string of [{ lat, lon, speed, timestamp }]
  busLabel        String
  districtId      String
  imageSnippet    String?  // Base64 JPEG cropped frame snippet
  status          String   @default("PENDING") // PENDING | ACKNOWLEDGED | ACTIONED | CLOSED
  authorityNotes  String?
  timestamp       DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([districtId, status])
  @@index([category])
}

model VehicleTrack {
  id            String   @id @default(uuid())
  trackId       String   @unique
  plateText     String?  // Nullable
  vehicleType   String
  confidence    Float
  speedKmh      Float
  trajectory    String   // JSON string of [[lat, lon], ...]
  lastSeenBus   String
  districtId    String
  lastSeenTime  DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([districtId])
}

model SafetyRiskZone {
  id                    String   @id @default(uuid())
  zoneName              String
  category              String   // SCHOOL_ZONE | PEDESTRIAN_CROSSING | BUS_STOP_CROWD
  riskScore             Float    // 0 to 100
  riskLevel             String   // LOW | MODERATE | HIGH | CRITICAL
  latitude              Float
  longitude             Float
  radiusMeters          Float    @default(150)
  pedestrianCount       Int      @default(0)
  nearMissCount         Int      @default(0)
  avgSpeedKmh           Float    @default(30)
  suggestedIntervention String
  districtId            String
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([districtId, riskLevel])
}

model PredictiveHotspot {
  id                    String   @id @default(uuid())
  locationName          String
  districtId            String
  latitude              Float
  longitude             Float
  recurrenceCount       Int
  severityScore         Float
  maintenancePriority   Float    // 0 to 100
  primaryDefectType     String   // POTHOLE | ROAD_CRACK | SURFACE_DAMAGE | WATERLOGGING
  recommendedAction     String
  createdAt             DateTime @default(now())

  @@index([districtId])
}

model UrbanRecommendation {
  id              String   @id @default(uuid())
  type            String   // WORK_ORDER | TRAFFIC_REROUTE | SAFETY_INTERVENTION
  title           String
  description     String
  urgency         String   // MEDIUM | HIGH | CRITICAL
  impactScore     Float    // 0 to 100
  estimatedCostINR Float?
  districtId      String
  status          String   @default("PROPOSED") // PROPOSED | APPROVED | DISPATCHED
  linkedEntityId  String?
  createdAt       DateTime @default(now())

  @@index([districtId, status])
}

